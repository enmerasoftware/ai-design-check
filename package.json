{
  "name": "@enmera/ai-design-check",
  "version": "0.3.0",
  "description": "Design rules and a zero-dependency checker for interfaces built with AI coding agents (Claude Code, Cursor, Codex): sentence case, one type and radius scale, one selector language, no generated-UI tells. English and Turkish.",
  "type": "module",
  "bin": {
    "ai-design-check": "bin/ai-design-check.js"
  },
  "exports": {
    ".": "./src/check.js",
    "./rules.json": "./rules.json",
    "./package.json": "./package.json"
  },
  "files": ["bin", "src", "rules.json", "RULES.md", "RULES.tr.md", "skills", "README.md", "README.tr.md", "CHANGELOG.md", "LICENSE"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "docs": "node scripts/docs.js",
    "test": "node --test",
    "check:docs": "node scripts/docs.js --check"
  },
  "keywords": ["ai", "ai-generated-ui", "claude-code", "cursor", "codex", "hooks", "accessibility", "i18n", "components", "design-system", "ui", "lint", "tailwind", "react", "sentence-case", "accessibility", "agent-skill", "claude", "design-rules"],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enmerasoftware/ai-design-check.git"
  },
  "homepage": "https://github.com/enmerasoftware/ai-design-check#readme",
  "bugs": "https://github.com/enmerasoftware/ai-design-check/issues",
  "license": "MIT",
  "author": "Enmera"
}
